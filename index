/* ============================================================
   AUTO-ALERT DISPATCH (simulated — no real message is sent)
============================================================ */
function estimatePopulation(site){
  const infra = INFRA[site.id];
  if(!infra) return null;
  const total = infra.reduce((s,i)=> s + (i.population||0), 0);
  return total || null;
}

function updateAlertsAndNotifications(){
  // Edge-triggered: log a new "dispatch" only the moment a site crosses
  // above the threshold, not on every re-render, so nudging the slider
  // repeatedly doesn't spam the log (mirrors the backend's cooldown logic).
  SITES.forEach(site=>{
    const rr = computeRisk(site, state.rainfall);
    const wasAbove = !!state.aboveThreshold[site.id];
    const isAbove = rr.score > ALERT_THRESHOLD;
    if(isAbove && !wasAbove){
      const pop = estimatePopulation(site);
      state.alertLog.unshift({
        time: new Date(),
        site, score: rr.score, category: rr.category,
        recipients: pop ? `~${pop.toLocaleString('en-IN')} residents (mapped settlements)` : 'no population figure on file for this site'
      });
      if(state.alertLog.length > 30) state.alertLog.length = 30;
    }
    state.aboveThreshold[site.id] = isAbove;
  });

  // Banner for the currently-selected site
  const site = selectedSite();
  const rr = computeRisk(site, state.rainfall);
  const bannerEl = document.getElementById('alertBannerSelected');
  if(rr.score > ALERT_THRESHOLD){
    const pop = estimatePopulation(site);
    bannerEl.innerHTML = `<div class="alert-banner">
      <div class="title">⚠ ${site.name} is above the alert threshold (${ALERT_THRESHOLD}/100)</div>
      Simulated dispatch: SMS + push + email would be sent now to ${pop ? `~${pop.toLocaleString('en-IN')} residents in mapped settlements` : 'residents registered for this area'}, plus an escalation flag to the ${site.state} disaster-management control room listed below.
    </div>`;
  } else {
    bannerEl.innerHTML = `<div class="map-hint">${site.name} is currently below the alert threshold (score ${rr.score}/100) — no dispatch triggered.</div>`;
  }

  // Dispatch log
  const logEl = document.getElementById('alertLogList');
  if(!state.alertLog.length){
    logEl.innerHTML = '<div class="route-empty">No site has crossed the alert threshold yet in this session.</div>';
  } else {
    logEl.innerHTML = state.alertLog.map(entry => `
      <div class="alert-log-row">
        <div><b>${entry.site.name}</b>, ${entry.site.state} — ${entry.category} (${entry.score}/100)<br><span class="meta">${entry.recipients}</span></div>
        <span class="meta">${entry.time.toLocaleTimeString()}</span>
      </div>`).join('');
  }
}

/* ============================================================
   ROUTING (real roads via OSRM public demo server)
============================================================ */
function nearestShelter(from){
  let best=null,bd=Infinity;
  SHELTERS.forEach(sh=>{
    const d = Math.pow(sh.lat-from.lat,2)+Math.pow(sh.lon-from.lon,2);
    if(d<bd){ bd=d; best=sh; }
  });
  return best;
}

function clearRoute(){
  if(state.routeLine){ state.map.removeLayer(state.routeLine); state.routeLine=null; }
}

async function runFindRoute(){
  const site = selectedSite();
  const shelter = nearestShelter(site);
  const results = document.getElementById('routeResults');
  results.innerHTML = '<div class="route-empty">Calculating route on the real road network…</div>';
  clearRoute();
  const url = `https://router.project-osrm.org/route/v1/driving/${site.lon},${site.lat};${shelter.lon},${shelter.lat}?overview=full&geometries=geojson`;
  try{
    const resp = await fetch(url);
    const data = await resp.json();
    if(!data.routes || !data.routes.length){ throw new Error('no route'); }
    const route = data.routes[0];
    const coords = route.geometry.coordinates.map(c=>[c[1],c[0]]);
    state.routeLine = L.polyline(coords, { color:'#F4F1E6', weight:4, dashArray:'8,6' }).addTo(state.map);
    state.map.fitBounds(state.routeLine.getBounds(), { padding:[30,30] });
    const distKm = (route.distance/1000).toFixed(1);
    const durMin = Math.round(route.duration/60);
    const rr = computeRisk(site, state.rainfall);
    results.innerHTML = `
      <div class="route-results">
        <div class="route-stat"><div class="k">Destination</div><div class="v" style="font-size:13px;">${shelter.name}</div></div>
        <div class="route-stat"><div class="k">Road distance</div><div class="v">${distKm} km</div></div>
        <div class="route-stat"><div class="k">Est. drive time</div><div class="v">${durMin} min</div></div>
        <div class="route-stat"><div class="k">Origin risk now</div><div class="v" style="color:${CATCOLOR[rr.key]}">${rr.category} (${rr.score}/100)</div></div>
      </div>`;
  } catch(err){
    const dLat=(shelter.lat-site.lat), dLon=(shelter.lon-site.lon);
    const straightKm = (Math.sqrt(dLat*dLat+dLon*dLon)*111).toFixed(0);
    state.routeLine = L.polyline([[site.lat,site.lon],[shelter.lat,shelter.lon]], { color:'#F4F1E6', weight:3, dashArray:'3,7', opacity:0.7 }).addTo(state.map);
    state.map.fitBounds(state.routeLine.getBounds(), { padding:[30,30] });
    results.innerHTML = `<div class="route-empty">Live routing service did not return a road route for this remote stretch (common for sparsely-mapped hill roads). Showing straight-line distance (~${straightKm} km) to <b>${shelter.name}</b> as a fallback — verify the actual road path with local authorities.</div>`;
  }
}

/* ============================================================
   WIRE UP
============================================================ */
function populateSelectors(){
  const stateSelect = document.getElementById('stateSelect');
  const states = [...new Set(SITES.map(s=>s.state))];
  states.forEach(st=>{ const o=document.createElement('option'); o.value=st; o.textContent=st; stateSelect.appendChild(o); });
  stateSelect.value = selectedSite().state;

  function refreshSiteOptions(){
    const siteSelect = document.getElementById('siteSelect');
    siteSelect.innerHTML='';
    SITES.filter(s=>s.state===stateSelect.value).forEach(s=>{
      const o=document.createElement('option'); o.value=s.id; o.textContent=s.name; siteSelect.appendChild(o);
    });
    siteSelect.value = state.selectedId && SITES.find(s=>s.id===state.selectedId).state===stateSelect.value ? state.selectedId : siteSelect.options[0].value;
  }
  refreshSiteOptions();

  stateSelect.addEventListener('change', ()=>{ refreshSiteOptions(); state.selectedId = document.getElementById('siteSelect').value; state.route=null; clearRoute(); focusSite(); renderAll(); });
  document.getElementById('siteSelect').addEventListener('change', (e)=>{ state.selectedId = e.target.value; state.route=null; clearRoute(); focusSite(); renderAll(); });
}

function focusSite(){
  const site = selectedSite();
  state.map.setView([site.lat,site.lon], 9, { animate:true });
}

function renderAll(){
  refreshMarkerColors();
  renderZoneInfo();
  renderStatus();
  renderCellStrip();
  renderScoreAndExplain();
  renderInfra();
  renderHistorical();
  renderEmergencyContacts();
  updateAlertsAndNotifications();
}

function init(){
  initMap();
  populateSelectors();

  document.getElementById('rainSlider').addEventListener('input',(e)=>{
    state.rainfall = +e.target.value;
    document.getElementById('rainVal').textContent = state.rainfall;
    renderAll();
  });
  document.getElementById('resetBtn').addEventListener('click', ()=>{
    state.rainfall = 60;
    document.getElementById('rainSlider').value = 60;
    document.getElementById('rainVal').textContent = 60;
    renderAll();
  });
  document.getElementById('btnSat').addEventListener('click', ()=>{
    state.map.removeLayer(state.darkLayer); state.satLayer.addTo(state.map);
    document.getElementById('btnSat').classList.add('active'); document.getElementById('btnDark').classList.remove('active');
  });
  document.getElementById('btnDark').addEventListener('click', ()=>{
    state.map.removeLayer(state.satLayer); state.darkLayer.addTo(state.map);
    document.getElementById('btnDark').classList.add('active'); document.getElementById('btnSat').classList.remove('active');
  });
  document.getElementById('findRouteBtn').addEventListener('click', runFindRoute);

  renderAll();
}

if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }

})();
