  document.getElementById('cellStrip').innerHTML = items.map(([k,v])=>`<div class="stat"><div class="k">${k}</div><div class="v">${v}</div></div>`).join('');
}
function renderScoreAndExplain(){
  const site = selectedSite(); const rr = computeRisk(site,state.rainfall);
  document.getElementById('scoreNum').textContent = rr.score;
  document.getElementById('scoreCat').textContent = rr.category;
  document.getElementById('scoreCat').style.color = CATCOLOR[rr.key];
  document.getElementById('scoreProb').textContent = 'probability '+(rr.probability*100).toFixed(1)+'%';
  document.getElementById('scoreLoc').textContent = site.name+', '+site.state;
  const circumference = 2*Math.PI*42;
  const arc = document.getElementById('scoreArc');
  arc.setAttribute('stroke-dasharray', circumference.toFixed(1));
  arc.setAttribute('stroke-dashoffset', (circumference*(1-rr.probability)).toFixed(1));
  arc.setAttribute('stroke', CATCOLOR[rr.key]);
  const top3 = rr.contributions.slice(0,3).map(c=>c.label.toLowerCase());
  document.getElementById('explainSentence').textContent = `Risk is ${rr.category.toLowerCase()} primarily because of ${top3[0]}, ${top3[1]} and ${top3[2]}.`;
  document.getElementById('contribList').innerHTML = rr.contributions.map(c=>{
    const pct = Math.round((c.value/(rr.probability||0.0001))*100);
    return `<div class="contrib-row"><div class="contrib-label"><span class="name">${c.label}</span><span class="pct">${isFinite(pct)?pct:0}%</span></div><div class="contrib-bar-bg"><div class="contrib-bar-fill" style="width:${Math.round(c.raw*100)}%; background:${CATCOLOR[rr.key]}"></div></div></div>`;
  }).join('');
}
function renderInfra(){
  const site = selectedSite(); const rr = computeRisk(site,state.rainfall);
  const nearby = INFRA[site.id] || [];
  const summary = document.getElementById('infraSummary');
  if(rr.category==='High'||rr.category==='Critical'){
    summary.textContent = nearby.length ? `${rr.category} risk site: ${nearby.length} mapped asset${nearby.length>1?'s':''} potentially exposed nearby.` : `${rr.category} risk site: no mapped infrastructure on file for this hotspot yet.`;
  } else {
    summary.textContent = `${rr.category} risk here — infrastructure exposure is not a priority at this site right now.`;
  }
  const listEl = document.getElementById('infraList');
  listEl.innerHTML = nearby.length ? nearby.map(n=>`<li><span>${n.name}${n.population?` · pop. ~${n.population}`:''}</span><span class="tag">${n.type}</span></li>`).join('') : '<li style="justify-content:center;color:var(--text-dim);">No infrastructure on file within this demo dataset</li>';
}
function renderHistorical(){
  const site = selectedSite(); const rr = computeRisk(site,state.rainfall);
  if(site.event){
    const d = Math.sqrt(Math.pow((rr.rainfallSite-site.event.rainfall_mm)/200,2)+Math.pow((rr.slope-site.event.slope)/40,2));
    const similarity = clamp(100*(1-d/1.4),5,99);
    document.getElementById('histPct').textContent = Math.round(similarity)+'%';
    document.getElementById('histDesc').innerHTML = `Reference event at ${site.name} (${site.event.date}): ${site.event.cause}. Reported/estimated conditions: ~${site.event.rainfall_mm} mm rainfall, ~${site.event.slope}° slope. Shown as similarity context, not a guarantee of recurrence.`;
  } else {
    document.getElementById('histPct').textContent = '—';
    document.getElementById('histDesc').textContent = `No documented reference landslide event is attached to ${site.name} in this demo dataset. Nearby hill districts have recorded monsoon-triggered slope failures historically — treat this site's score as model-only until validated.`;
  }
}

