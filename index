const ALERT_THRESHOLD = 50;

function siteSeedValues(site){
  const rng = mulberry32(hashSeed(site.id));
  const slopeBase = site.event ? site.event.slope : clamp(14+rng()*30,10,55);
  const vegetation = clamp(0.75 - rng()*0.5, 0.08, 0.85);
  const soilBase = clamp(20 + rng()*35, 12, 70);
  return { slope: Math.round(slopeBase), vegetation: +vegetation.toFixed(2), soilBase: Math.round(soilBase) };
}

function computeRisk(site, rainfall24h){
  const seed = siteSeedValues(site);
  const rainfallSite = clamp(rainfall24h*(0.85+((seed.slope/55))*0.3), 0, 450);
  const soilMoisture = clamp(seed.soilBase + (rainfallSite/320)*48 - 8, 5, 100);
  const rainNorm = clamp(rainfallSite/300,0,1);
  const slopeNorm = clamp(seed.slope/55,0,1);
  const soilNorm = clamp(soilMoisture/100,0,1);
  const vegLossNorm = clamp(1-seed.vegetation,0,1);
  const histTerm = site.historical ? 1 : 0;
  const contributions = [
    {key:'rain',label:'Cumulative rainfall',raw:rainNorm,value:WEIGHTS.rain*rainNorm},
    {key:'slope',label:'Slope steepness',raw:slopeNorm,value:WEIGHTS.slope*slopeNorm},
    {key:'soil',label:'Soil moisture',raw:soilNorm,value:WEIGHTS.soil*soilNorm},
    {key:'veg',label:'Vegetation loss',raw:vegLossNorm,value:WEIGHTS.veg*vegLossNorm},
    {key:'hist',label:'Historical landslide proximity',raw:histTerm,value:WEIGHTS.hist*histTerm}
  ];
  const probability = clamp(contributions.reduce((s,c)=>s+c.value,0),0,1);
  const score = Math.round(probability*100);
  let category,key2;
  if(score<20){category='Very Low';key2='verylow';}
  else if(score<40){category='Low';key2='low';}
  else if(score<60){category='Moderate';key2='moderate';}
  else if(score<80){category='High';key2='high';}
  else {category='Critical';key2='critical';}
  contributions.sort((a,b)=>b.value-a.value);
  return { probability, score, category, key:key2, rainfallSite:Math.round(rainfallSite), soilMoisture:Math.round(soilMoisture), slope:seed.slope, vegetation:seed.vegetation, contributions };
}

function warningStateFor(category){
  if(category==='Very Low'||category==='Low') return 'Normal';
  if(category==='Moderate') return 'Watch';
  if(category==='High') return 'Warning';
  return 'Critical';
}

const CATCOLOR = { verylow:'#3A8F5E', low:'#6BAE6E', moderate:'#D6A83B', high:'#E0812F', critical:'#C23A2E' };

