function regionWideStatus(){
  const order=['Normal','Watch','Warning','Critical'];
  let worst='Normal';
  SITES.forEach(site=>{
    const st = warningStateFor(computeRisk(site,state.rainfall).category);
    if(order.indexOf(st)>order.indexOf(worst)) worst=st;
  });
  return worst;
}
function renderStatus(){
  const st = regionWideStatus();
  const badge = document.getElementById('statusBadge');
  badge.className = 'status-badge '+st.toLowerCase();
  document.getElementById('statusText').textContent = st;
  const caps={ Normal:'No monitored site above moderate risk — routine monitoring.', Watch:'Some sites at moderate risk — increase monitoring frequency.', Warning:'High-risk sites detected — prepare field teams and review evacuation routes.', Critical:'Critical risk sites present — urgent assessment per official protocol.' };
  document.getElementById('statusCaption').textContent = caps[st];
}
